# Copy this file to .env and set your keys locally.

# Supabase (client-side, safe to expose — RLS protects data)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Groq AI (server-side only — used by api/ai/evaluate.ts)
GROQ_API_KEY=your_groq_api_key_here

# Supabase service role (server-side only — used by edge functions)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
